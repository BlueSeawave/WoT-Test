<?xml version="1.0" encoding="utf-8"?>
<NPCCharacters>
<!--Example 1 -->
	<!--This guy has a fixed name-->
  <NPCCharacter id="wanderer_seanchan_0" name="{=WOTwand1}Ihaka Shumada" age="28" voice="earnest" culture="Culture.vlandia" default_group="Infantry" is_female="false" is_template="true" is_hero="false" occupation="Wanderer">
    <face>
		<!--variable body properties-->
      <face_key_template value="BodyProperty.fighter_aserai" />
      <hair_tags>
        <hair_tag name="Tousled" />
      </hair_tags>
      <beard_tags>
        <beard_tag name="Cleanshaven" />
      </beard_tags>
    </face>
    <skills>
		<!--Fixed skills example-->
      <skill id="OneHanded" value="250" />
      <skill id="TwoHanded" value="200" />
      <skill id="Polearm" value="70" />
      <skill id="Bow" value="50" />
      <skill id="Crossbow" value="150" />
      <skill id="Throwing" value="150" />
      <skill id="Riding" value="200" />
      <skill id="Athletics" value="250" />
      <skill id="Crafting" value="25" />
      <skill id="Scouting" value="140" />
      <skill id="Tactics" value="250" />
      <skill id="Charm" value="50" />
      <skill id="Leadership" value="250" />
      <skill id="Trade" value="25" />
      <skill id="Steward" value="50" />
      <skill id="Medicine" value="100" />
    </skills>
    <Traits>
      <Trait id="Honor" value="2" />
      <Trait id="Calculating" value="1" />
      <Trait id="Mercy" value="2" />
      <Trait id="Valor" value="1" />
    </Traits>
    <Equipments>
		<!--If you want to define equipment you need to use the EquipmentRoster tag-->
      <EquipmentRoster>
        <equipment slot="Item0" id="Item.khuzait_sword_1_t2" />
        <equipment slot="Cape" id="Item.Elfrangerhoodandcloak2" />
        <equipment slot="Body" id="Item.Elfassasinarmor3" />
        <equipment slot="Leg" id="Item.Elfboots3" />
      </EquipmentRoster>
      <EquipmentRoster>
        <equipment slot="Item0" id="Item.khuzait_sword_1_t2" />
        <equipment slot="Cape" id="Item.Elfrangerhoodandcloak1" />
        <equipment slot="Body" id="Item.Elfassasinarmor3" />
        <equipment slot="Leg" id="Item.Elfboots3b" />
      </EquipmentRoster>
      <EquipmentRoster civilian="true">
        <equipment slot="Item0" id="Item.khuzait_sword_1_t2" />
        <equipment slot="Body" id="Item.khuzait_belt_leather" />
        <equipment slot="Leg" id="Item.leather_cavalier_boots" />
      </EquipmentRoster>
    </Equipments>
  </NPCCharacter>
	<!--Example 2-->
	<!--This guy has a variable first name and uses a skill template instead of fixed skills for variety-->
  <NPCCharacter id="wanderer_altara_0" name="{=WOTwand2}{FIRSTNAME} the Gleeman" voice="curt" age="32" is_female="false" default_group="Ranged" is_template="true" is_hero="false" culture="Culture.battania" occupation="Wanderer" skill_template="SkillSet.spc_wanderer_aserai_8_skills">
    <face>
      <face_key_template value="BodyProperty.villager_aserai" />
    </face>
    <Traits>
      <Trait id="Honor" value="1" />
      <Trait id="Mercy" value="1" />
    </Traits>
    <Equipments>
		<!--This set up uses an equipment set which is maintained in a seperate xml.  Great when you want a lot of variety with the gear sets.-->
      <EquipmentSet id="npc_companion_equipment_template_aserai" civilian="true" />
      <EquipmentSet id="npc_companion_equipment_template_aserai" />
    </Equipments>
  </NPCCharacter>
  <NPCCharacter id="wanderer_cairhien_0" name="{=WOTwand3}{FIRSTNAME} the Gleeman" voice="curt" age="31" is_female="false" default_group="Ranged" is_template="true" is_hero="false" culture="Culture.empire" occupation="Wanderer" skill_template="SkillSet.spc_wanderer_aserai_8_skills">
    <face>
      <face_key_template value="BodyProperty.villager_empire" />
    </face>
    <Traits>
      <Trait id="Honor" value="1" />
      <Trait id="Mercy" value="1" />
    </Traits>
    <Equipments>
      <EquipmentSet id="npc_companion_equipment_template_empire" civilian="true" />
      <EquipmentSet id="npc_companion_equipment_template_empire" />
    </Equipments>
  </NPCCharacter>


